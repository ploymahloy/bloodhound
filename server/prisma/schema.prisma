generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  
  firstName     String?
  lastName      String?
  bio           String?   @db.Text
  role          Role      @default(USER) 
  
  emailVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActiveAt  DateTime?

  @@index([email])
  @@index([username])
}

enum Role {
  USER
  ADMIN
}

enum ListingType {
  BUSINESS
  INDIVIDUAL
}

model Listing {
  id        String      @id @default(uuid())
  name      String
  type      ListingType
  service   String
  services  String[]
  address   String?
  city      String
  phone     String
  avatarUrl String?
  promo     String?     @db.Text
  latitude  Float
  longitude Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([city])
  @@index([service])
}